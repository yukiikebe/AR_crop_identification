{
    "name": "arkansas_fastdiffsr_x4_inference",
    "phase": "val",
    "gpu_ids": [
        0
    ],
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },
    "datasets": {
        "train": {
            "name": "Train",
            "mode": "LRHR",
            "dataroot": "runtime_data/unused_train_placeholder",
            "datatype": "img",
            "l_resolution": 64,
            "r_resolution": 256,
            "batch_size": 1,
            "num_workers": 4,
            "use_shuffle": true,
            "data_len": -1,
            "img_mask": "no"
        },
        "val": {
            "name": "Test",
            "mode": "LRHR",
            "dataroot": "runtime_data/unused_val_placeholder",
            "datatype": "img",
            "l_resolution": 64,
            "r_resolution": 256,
            "data_len": -1,
            "img_mask": "no"
        }
    },
    "model": {
        "which_model_G": "fastdiffsr",
        "finetune_norm": false,
        "unet": {
            "in_channel": 6,
            "out_channel": 3,
            "inner_channel": 64,
            "channel_multiplier": [
                1,
                2,
                4,
                4
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 2,
            "dropout": 0.2
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear_cosine",
                "n_timestep": 20,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "linear_cosine",
                "n_timestep": 20,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 256,
            "channels": 3,
            "conditional": true
        },
        "uno_hiloc": true,
        "uno_in_width": 3,
        "uno_width": 24,
        "uno_out_width": 3
    },
    "train": {
        "n_iter": 915200,
        "val_freq": 9152,
        "save_checkpoint_freq": 9152,
        "print_freq": 1144,
        "optimizer": {
            "type": "adam",
            "lr": 2e-4
        },
        "ema_scheduler": {
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "sr_fastdiffsr_infer"
    }
}
